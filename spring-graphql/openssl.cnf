[req]
default_bits = 2048
prompt = no
default_md = sha256
req_extensions = req_ext
distinguished_name = dn

[dn]
C = YourCountry
L = YourCity
O = YourOrganization
OU = YourOrgUnit
CN = YourCommonName

[req_ext]
subjectAltName = @alt_names
1.3.6.1.4.1.311.25.2 = ASN1:OCTETSTRING:0420010500000000000515000000947A1C3C938F764602429B2800020000

[alt_names]
DNS.1 = example.com
DNS.2 = server1.example.com
